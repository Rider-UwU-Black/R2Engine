; R2Engine indexed textured meshlet emitter.
; One meshlet produces exactly one XGKICK. TOP layout: params, exact GIF tag,
; compact STQ/RGBAQ/XYZ records, compact index qwords, then the fixed output
; bank at qword 221. params.y supplies the compact index offset.

	.vu
	.align 4
	.global R2VU1Transform_CodeStart
	.global R2VU1Transform_CodeEnd

R2VU1Transform_CodeStart:
	NOP                              xtop    VI02
	NOP                              ilw.x   VI09,0(VI02)
	NOP                              ilw.y   VI04,0(VI02)
	NOP                              iadd    VI04,VI04,VI02
	NOP                              iaddiu  VI05,VI02,221
	NOP                              lq      VF01,1(VI02)
	NOP                              sq      VF01,0(VI05)
	NOP                              iaddiu  VI08,VI05,1

R2VU1Transform_TriangleLoop:
	NOP                              ilw.x   VI10,0(VI04)
	NOP                              iadd    VI11,VI10,VI10
	NOP                              iadd    VI11,VI11,VI10
	NOP                              iaddiu  VI12,VI02,2
	NOP                              iadd    VI11,VI11,VI12
	NOP                              lq      VF02,0(VI11)
	NOP                              lq      VF03,1(VI11)
	NOP                              lq      VF04,2(VI11)
	NOP                              sqi     VF02,(VI08++)
	NOP                              sqi     VF03,(VI08++)
	NOP                              sqi     VF04,(VI08++)

	NOP                              ilw.y   VI10,0(VI04)
	NOP                              iadd    VI11,VI10,VI10
	NOP                              iadd    VI11,VI11,VI10
	NOP                              iadd    VI11,VI11,VI12
	NOP                              lq      VF02,0(VI11)
	NOP                              lq      VF03,1(VI11)
	NOP                              lq      VF04,2(VI11)
	NOP                              sqi     VF02,(VI08++)
	NOP                              sqi     VF03,(VI08++)
	NOP                              sqi     VF04,(VI08++)

	NOP                              ilw.z   VI10,0(VI04)
	NOP                              iadd    VI11,VI10,VI10
	NOP                              iadd    VI11,VI11,VI10
	NOP                              iadd    VI11,VI11,VI12
	NOP                              lq      VF02,0(VI11)
	NOP                              lq      VF03,1(VI11)
	NOP                              lq      VF04,2(VI11)
	NOP                              sqi     VF02,(VI08++)
	NOP                              sqi     VF03,(VI08++)
	NOP                              sqi     VF04,(VI08++)

	NOP                              iaddiu  VI04,VI04,1
	NOP                              isubiu  VI09,VI09,1
	NOP                              ibne    VI09,VI00,R2VU1Transform_TriangleLoop
	NOP                              NOP

	NOP                              xgkick  VI05

	NOP[E]                           NOP
	NOP                              NOP

	.align 4
R2VU1Transform_CodeEnd:
